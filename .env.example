# ── 데이터베이스 (MongoDB — 유니버스 저장) ──────────────────────────
MONGODB_URI="mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?appName=Cluster0"
# MONGODB_DB="market_research"   # 기본값 market_research

# ── 관리자 인증 (쓰기·갱신 API + /manage 보호) ─────────────────────
# openssl rand -base64 24  로 생성. 로그인 비밀번호 + 스크립트 x-app-token 겸용.
# 미설정 시 /manage·쓰기 API 는 전면 차단(fail-closed).
APP_PASSWORD=""

# Vercel Cron 검증용 (Vercel 이 자동 주입). 미설정 시 cron 라우트 차단.
CRON_SECRET=""

# ── L1 공시·재무제표 API 키 (prd.md §4.1) ───────────────────────────
# 미국(SEC EDGAR): 키 불필요. User-Agent 만 지정 권장.
SEC_USER_AGENT="global-market-research (personal) your-email@example.com"

# 한국(OpenDART): https://opendart.fss.or.kr 에서 발급
DART_API_KEY=""

# 한국 시세(KRX OPEN API, 선택): http://openapi.krx.co.kr — 없으면 Stooq/Yahoo 폴백
KRX_API_KEY=""

# 한국 채권금리(한국은행 ECOS, 선택): https://ecos.bok.or.kr — 국고채·회사채 일별 금리
ECOS_API_KEY=""

# 일본(EDINET API v2): https://api.edinet-fsa.go.jp 에서 발급
EDINET_API_KEY=""

# 일본(J-Quants v2, 선택): x-api-key. 무료 플랜 = 종목 마스터 + 12주 지연 시세.
JQUANTS_API_KEY=""

# ── 참고 ────────────────────────────────────────────────────────────
# L2 시세(Stooq), L4 컨센서스(yahoo-finance2)는 키가 필요 없다.
# yahoo-finance2 는 개인용/비상업 한정 (prd.md §4.3).

# 공공데이터포털(data.go.kr) — 금융위원회_주식권리일정정보
DATA_GO_KR_KEY=""

# 미국 배당 이력(Polygon.io / 현 Massive) — 선언·권리락·기준·지급일 4개 날짜.
# https://polygon.io (or massive.com) 무료 키. 미설정 시 yahoo 폴백(권리락일만).
POLYGON_API_KEY=""

# ── 종목뉴스 선택 번역·요약 ──────────────────────────────────────────
# Claude API(번역·요약·진위판단, Haiku 4.5) — https://console.anthropic.com
ANTHROPIC_API_KEY=""

# 한국 뉴스 검색(NAVER API HUB, 무료·일 25,000건) — https://www.ncloud.com
# 콘솔에서 "검색" 상품 신청 후 API Gateway 키 발급.
NAVER_APIHUB_KEY_ID=""
NAVER_APIHUB_KEY_SECRET=""

# 월 LLM 과금 상한($10) 초과 시 이메일 알림 — https://resend.com 무료 키.
# 미설정 시 이메일만 스킵(앱 내 에러 팝업은 항상 뜸).
RESEND_API_KEY=""
ALERT_EMAIL_TO=""
